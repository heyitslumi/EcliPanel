---
const { title = 'EcliPanel Docs' } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <style>
      :root {
        --bg: #09090b;
        --panel: #111118;
        --text: #e5e7eb;
        --muted: #a1a1aa;
        --accent: #8b5cf6;
        --accent-soft: rgba(139, 92, 246, 0.15);
        --border: rgba(255,255,255,0.1);
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
        background: radial-gradient(circle at top, #1b1035 0%, var(--bg) 35%);
        color: var(--text);
        line-height: 1.65;
      }
      a { color: #a78bfa; text-decoration: none; }
      a:hover { color: #c4b5fd; }
      .shell { max-width: 1120px; margin: 0 auto; padding: 24px; }
      .top {
        display: flex; align-items: center; justify-content: space-between;
        border: 1px solid var(--border); background: var(--panel);
        padding: 14px 16px; border-radius: 14px;
      }
      .brand { font-weight: 700; letter-spacing: .2px; }
      .nav { display: flex; gap: 12px; flex-wrap: wrap; }
      .nav a { padding: 6px 10px; border-radius: 8px; background: transparent; }
      .nav a:hover { background: var(--accent-soft); }
      main {
        margin-top: 18px;
        border: 1px solid var(--border);
        background: color-mix(in oklab, var(--panel) 92%, black);
        border-radius: 14px;
        padding: 26px;
      }
      h1 { margin-top: 0; }
      h2 { margin-top: 32px; border-bottom: 1px solid var(--border); padding-bottom: 8px; }
      code { background: rgba(255,255,255,0.08); padding: 2px 6px; border-radius: 6px; }
      pre { background: #0a0a0f; border: 1px solid var(--border); border-radius: 10px; padding: 14px; overflow: auto; }
      table { width: 100%; border-collapse: collapse; }
      th, td { border: 1px solid var(--border); padding: 10px; text-align: left; }
      .muted { color: var(--muted); }
    </style>
  </head>
  <body>
    <div class="shell">
      <header class="top">
        <div class="brand">EcliPanel Docs</div>
        <nav class="nav">
          <a href="/">Home</a>
          <a href="/docs/eclipanel">EcliPanel</a>
          <a href="/docs/wings">Wings</a>
          <a href="/docs/environment">Environment</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
