# ==============================================
# EcliPanel Backend Environment Reference
# Copy to backend/.env and set all required keys.
# ==============================================

# --- Server runtime ---
HOST=0.0.0.0
PORT=3001
NODE_ENV=development
EXIT_ON_UNCAUGHT=0
ELYSIA_HOURLY_RESTART=true

# --- Database (required) ---
# Supported: mariadb, mysql, postgres
DB_TYPE=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=
# Optional: full connection string override
# DATABASE_URL=
# Optional tuning
DB_LOG_QUERIES=true
DB_MAX_QUERY_MS=200
DB_POOL_SIZE=20
# Optional SSL for DB client
DB_SSL=false

# --- Cache / rate-limit store (required) ---
REDIS_URL=redis://localhost:6379

# --- Core URLs / origins (required) ---
FRONTEND_URL=http://localhost:3000
PANEL_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
APP_URL=eclipanel
# WebAuthn expected origin and RP ID
ORIGIN=http://localhost:3000
RP_ID=localhost

# --- Authentication + encryption (required) ---
# Generate with: bun run gen:jwt-secret
JWT_SECRET=
# Generate with: bun run gen:pq-jwt-seed
PQ_JWT_SEED=
# Symmetric encryption key used for sensitive node credentials
NODE_ENCRYPTION_KEY=
# 64-byte base64 seed (stable across restarts)
NODE_PQ_ENCRYPTION_SEED=

# Optional JWT cookie behavior
JWT_COOKIE_NAME=token
JWT_COOKIE_DOMAIN=
JWT_COOKIE_SECURE=false
JWT_COOKIE_MAX_AGE=2592000

# --- DNS providers ---
PDNS_BASE_URL=
PDNS_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BASE_ZONE=
CLOUDFLARE_CREATE_SUBZONE=0

# --- Wings integration ---
WINGS_ALLOW_INVALID_CERT=false

# --- SMTP (panel email delivery) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TLS_ALLOW_INVALID=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=EcliPanel
SMTP_REPLY_TO=
SMTP_POOL=true
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100
SMTP_CONNECTION_TIMEOUT=10000
SMTP_SOCKET_TIMEOUT=15000
SMTP_GREETING_TIMEOUT=10000

# --- Mailbox / Mailcow integration (optional) ---
MAILCOW_API_URL=
MAILCOW_API_KEY=
MAILCOW_API_SECRET=
MAILBOX_DOMAIN=
MAIL_DOMAIN=
MAILBOX_INBOUND_SECRET=
MAILCOW_TIMEOUT_MS=30000
MAILCOW_RETRIES=2

MAILBOX_SMTP_HOST=mail.${MAILBOX_DOMAIN}
MAILBOX_SMTP_PORT=587
MAILBOX_SMTP_SECURE=false
MAILBOX_IMAP_HOST=mail.${MAILBOX_DOMAIN}
MAILBOX_IMAP_PORT=993
MAILBOX_IMAP_SECURE=true

# Optional Dovecot master credentials for mailbox sync/fetch flows
DOVECOT_MASTER_USER=
DOVECOT_MASTER_PASS=
DOVECOT_MASTER_DOMAIN=mailcow.local
IMAP_FETCH_CRON=*/1 * * * *
IMAP_FETCH_CONCURRENCY=3
IMAP_FETCH_ACCOUNT_TIMEOUT_MS=45000
MAILBOX_PASSWORD_ROTATION_CRON=0 4 * * *

# --- OAuth / student verification ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=
HACKCLUB_REDIRECT_URI=

# --- Slack integration (optional) ---
SLACK_BOT_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_SOCKET_MODE=true
SLACK_GITHUB_REDIRECT_URI=https://ecli.app/api/auth/github/callback

# --- Identity / KYC ---
EU_ID_DISABLED=true
KYC_RATE_IP=20
KYC_WINDOW_IP=3600
KYC_RATE_USER=3
KYC_WINDOW_USER=86400

# --- Captcha ---
CAPTCHA_SECRET=
CAPTCHA_INVISIBLE_SECRET=
CAPTCHA_TTS_VOICE=en
CAPTCHA_TTS_SPEED=150

# --- Company + invoice branding ---
INVOICE_LOGO_PATH=./frontend/public/assets/icons/logo.png
COMPANY_NAME=EclipseSystems
COMPANY_ADDRESS=
INVOICE_ISSUED_FROM_NAME=
INVOICE_ISSUED_FROM_ADDRESS=
INVOICE_ISSUED_FROM_CITY=
INVOICE_ISSUED_FROM_STATE=
INVOICE_ISSUED_FROM_ZIP=
INVOICE_ISSUED_FROM_COUNTRY=
INVOICE_ISSUED_FROM_TAX_ID=
INVOICE_ISSUED_FROM_EMAIL=

# --- SOC / abuse / alerts ---
ANTIABUSE_AI_ENABLED=true
ABUSE_REPORT_EMAIL=abuse@example.com
SOC_ABUSEIPDB_API_KEY=
SOC_ALERT_EMAIL=
SOC_ALERT_WEBHOOK_URL=
SOC_ALERT_EMAIL_SEVERITIES=critical,high

# --- Export safety limits ---
EXPORT_MAX_FILE_BYTES=0
EXPORT_JOB_MAX_FILES_PER_SERVER=5000
EXPORT_JOB_MAX_TOTAL_BYTES=1073741824
EXPORT_JOB_RETENTION_DAYS=7

# --- Optional anti-abuse runtime tuning ---
ANTIABUSE_THROTTLE_CPU_LIMIT_PERCENT=30
ANTIABUSE_THROTTLE_DURATION_SECONDS=300
ANTIABUSE_AGENT_ACTIVE_MS=90000
ANTIABUSE_AI_MODEL_ID=

# --- Optional tunnel defaults ---
TUNNEL_PUBLIC_HOST=
TUNNEL_PORT_RANGE=20000-29999

# --- Contact / support branding ---
ADMIN_EMAIL=
SUPPORT_EMAIL=
MAIL_FROM=
MAIL_FROM_NAME=EcliPanel

# --- Internal/admin advanced keys (optional) ---
ECLI_ADMIN_KEY=
GH_TOKEN=
GITHUB_TOKEN=
GITHUB_REPOSITORY=heyitslumi/EcliPanel
GITHUB_REPOSITORY_URL=https://github.com/heyitslumi/EcliPanel

# --- Optional service aliases ---
VALKEY_URL=
