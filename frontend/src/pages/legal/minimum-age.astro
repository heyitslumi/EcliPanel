---
import BaseLayout from "../../layouts/BaseLayout.astro";

let ageData: any = null;
try {
  const backendUrl = ((process.env.BACKEND_URL || "") || (process.env.PUBLIC_API_BASE || "") || "").replace(/\/+$/, "");
  const res = await fetch(`${backendUrl}/public/minimum-age`, { cache: "no-store" });
  if (res.ok) ageData = await res.json();
} catch {}
---

<BaseLayout title="Country Minimum Age Requirements — EclipseSystems" description="Registration age policy by country">
  <main class="px-auto w-full px-4 py-10 sm:px-6 lg:px-8 flex justify-center bg-black">
    <div class="space-y-8 max-w-6xl mt-20">
      <section class="text-center mt-10">
        <p class="text-[clamp(2.5rem,8vw,6.5rem)] leading-none font-semibold tracking-tight text-foreground">
          Country Minimum Age Requirements
        </p>
        <p class="text-sm leading-7 text-white/70 sm:text-base">
          Our registration age policy depends on your country.
        </p>
      </section>

      <div class="grid gap-4 md:grid-cols-3">
        <div class="bg-white/10 p-5">
          <p class="text-2xl font-semibold text-white/70">Default minimum age</p>
          <p class="mt-2 text-3xl font-semibold text-white">13 years</p>
        </div>
        <div class="bg-white/10 p-5">
          <p class="text-2xl font-semibold text-white/70">EU / UK minimum age</p>
          <p class="mt-2 text-3xl font-semibold text-white">14 years</p>
        </div>
      </div>

      <section class="mt-15">
        <h2 class="text-2xl font-semibold text-foreground">How this works</h2>
        <div class="mt-1 text-[16px] leading-10 text-white/70">
          <p>We apply a base registration age of 13 years. A higher minimum of 14 years applies to the European Union and United Kingdom.</p>
          <p>Some countries may have higher custom minimums that override the base policy.</p>
          <p>If your country is not listed below, the default age rule applies.</p>
        </div>
      </section>

      {ageData?.rules?.length > 0 && (
        <section class="mt-15">
          <h2 class="text-2xl font-semibold text-foreground">Country-specific overrides</h2>
          <table class="min-w-full divide-y divide-border text-sm mt-4">
            <thead>
              <tr>
                <th class="px-4 py-3 text-left font-medium text-muted-foreground">Country</th>
                <th class="px-4 py-3 text-left font-medium text-muted-foreground">Minimum age</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              {ageData.rules.map((rule: any) => (
                <tr>
                  <td class="px-4 py-3 text-foreground capitalize">{rule.country}</td>
                  <td class="px-4 py-3 text-foreground">{rule.minimumAge} years</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )}

      <section class="mt-15 pb-20">
        <p class="text-[16px] leading-7 text-white/70">
          For the most current legal guidance, please review our <a class="font-medium text-indigo-400 hover:text-indigo-300 transition-colors" href="/legal/terms-of-service">Terms of Service</a> and <a class="font-medium text-indigo-400 hover:text-indigo-300 transition-colors" href="/legal/privacy-policy">Privacy Policy</a>.
        </p>
      </section>
    </div>
  </main>
</BaseLayout>