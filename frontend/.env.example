# ==============================================
# EcliPanel Frontend Environment Reference
# Copy to frontend/.env and adjust for your deployment.
# ==============================================

# Server-side backend URL (used by SSR/server fetches)
BACKEND_URL=http://localhost:3001

# Client/browser API base (used by apiFetch)
NEXT_PUBLIC_API_BASE=http://localhost:3001

# Optional direct Wings base for proxied or direct Wings requests
NEXT_PUBLIC_WINGS_BASE=http://localhost:8080

# Public site URL for metadata/canonicals
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional build metadata shown in panel footer/version UI
NEXT_PUBLIC_COMMIT_SHA=
NEXT_PUBLIC_REPO_URL=https://github.com/heyitslumi/EcliPanel

# Feature flags used in student verification/billing UI
NEXT_PUBLIC_HACKCLUB_STUDENT_ENABLED=false
NEXT_PUBLIC_GITHUB_STUDENT_ENABLED=false

# Legacy compatibility vars (Astro/public aliases)
PUBLIC_API_BASE=
PUBLIC_WINGS_BASE=
PUBLIC_SITE_URL=
PUBLIC_COMMIT_SHA=
PUBLIC_REPO_URL=
PUBLIC_HACKCLUB_STUDENT_ENABLED=false

# Optional local dev server binding (dev.sh / astro dev contexts)
HOST=0.0.0.0
PORT=3000
